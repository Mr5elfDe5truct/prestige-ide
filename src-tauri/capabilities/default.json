{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://127.0.0.1:*" }, { "url": "http://localhost:*" }]
    }
  ]
}
